# 复制为 .env 后按需修改。不要把真实 .env 提交到仓库。

# 应用只监听本机，由现有的反向代理转发过来。
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data

# 放在 Caddy / Nginx 后面时保持为 1，这样才会根据 HTTPS 设置安全 Cookie。
TRUST_PROXY=1

# 登录保持天数，1 到 180。
SESSION_DAYS=30

# 单张照片上限（MB），1 到 30。服务器会再压缩。
MAX_UPLOAD_MB=12

# 照片总张数上限。
MAX_PHOTOS=2000

# 纪念日提醒的小时（0-23），按你们在应用里设置的时区。
REMINDER_HOUR=9

# Web Push 联系方式，只是标识，不是登录邮箱。
VAPID_SUBJECT=mailto:couple@localhost

# 还没完成初始化时的默认时区。初始化页面仍会让你们自己选。
DEFAULT_TIMEZONE=Asia/Shanghai

# Docker 映射到宿主机的端口，只绑定 127.0.0.1。
# HOST_PORT=8787

# 只有在你确认 80/443 没有被现有代理占用、并使用 docker compose --profile caddy 时才需要。
# DOMAIN=couple.example.com
# ACME_EMAIL=you@example.com
